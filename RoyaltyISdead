-- Helper functions
local function getStallEvent()
    local success, event = pcall(function()
        return game:GetService("ReplicatedStorage")
            :WaitForChild("Packages", 5)
            :WaitForChild("Knit", 5)
            :WaitForChild("Services", 5)
            :WaitForChild("StallService", 5)
            :WaitForChild("RE", 5)
            :WaitForChild("Event", 5)
    end)
    if not success or not event then
        Rayfield:Notify({ Title = "Error", Content = "Failed to find StallService event.", Duration = 3 })
        return nil
    end
    return event
end

local purchaseDelay = 0.1 -- Default delay
local function bulkBuy(stallName, items)
    local event = getStallEvent()
    if not event then return end
    local root = workspace:WaitForChild("World", 5)
                     :WaitForChild("Interactables", 5)
                     :WaitForChild("Stores", 5)
                     :WaitForChild(stallName, 5)
    if not root then
        Rayfield:Notify({ Title = "Error", Content = "Failed to find " .. stallName .. ".", Duration = 3 })
        return
    end
    for _, item in ipairs(items) do
        event:FireServer(root, item)
        task.wait(purchaseDelay)
    end
    Rayfield:Notify({ Title = "Purchase Complete", Content = "Bought all selected items from " .. stallName .. ".", Duration = 3 })
end

