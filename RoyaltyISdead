        transactionHistory = {}
        historyDropdown:Set({"No transactions yet"})
        updateSilverLabels()
        Rayfield:Notify({ Title = "Success", Content = "Initial silver reset to " .. formatNumber(initialSilver) .. ".", Duration = 3 })
