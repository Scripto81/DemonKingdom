-- Function to format numbers with commas
local function formatNumber(num)
    local formatted = tostring(math.floor(num))
    local k
    while true do
        formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", '%1,%2')
        if k == 0 then break end
    end
    return formatted
end

-- Function to update transaction history
local function updateHistory(amount)
    local timestamp = os.date("%H:%M:%S")
    local entry = string.format("%s: %s%s silver", timestamp, amount > 0 and "+" or "-", formatNumber(math.abs(amount)))
    table.insert(transactionHistory, 1, entry)
    if #transactionHistory > maxHistory then
        table.remove(transactionHistory, #transactionHistory)
    end
    local options = #transactionHistory > 0 and transactionHistory or {"No transactions yet"}
    historyDropdown:Set(options)
end

-- Function to update all labels
local function updateSilverLabels()
    local currentSilver = silver.Value
    local difference = currentSilver - initialSilver
    local change = currentSilver - lastSilver
    if change ~= 0 then
        updateHistory(change)
        if math.abs(change) >= 1000 then
            Rayfield:Notify({
                Title = "Silver Change",
                Content = (change > 0 and "Gained " or "Lost ") .. formatNumber(math.abs(change)) .. " silver!",
                Duration = 5
            })
        end
    end
    lastSilver = currentSilver
    if difference == 0 then
        statusLabel:Set("No change from initial silver")
    elseif difference > 0 then
        statusLabel:Set("Above initial by " .. formatNumber(difference) .. " silver")
    else
        statusLabel:Set("Below initial by " .. formatNumber(math.abs(difference)) .. " silver")
    end
    currentLabel:Set("Current: " .. formatNumber(currentSilver) .. " silver")
    initialLabel:Set("Initial: " .. formatNumber(initialSilver) .. " silver")
end

-- Connect silver change tracking
silver:GetPropertyChangedSignal("Value"):Connect(updateSilverLabels)

-- Initial update
updateSilverLabels()

